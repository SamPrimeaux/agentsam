{
  "name": "@inneranimalmedia/agentsam-core-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "check": "npm test && npm run validate:manifests && node --check src/worker.js",
    "test": "node --test",
    "validate:manifests": "node scripts/validate-component-manifests.mjs",
    "component:new": "node scripts/create-component-capsule.mjs",
    "build:assets": "node scripts/sync-public-assets.mjs",
    "deploy": "npm run build:assets && npx wrangler deploy --var GIT_SHA:$(git rev-parse HEAD)"
  },
  "devDependencies": {
    "wrangler": "^4.118.0"
  }
}
